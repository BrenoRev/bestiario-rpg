# Credenciais do login com Google para o Supabase LOCAL (npx supabase start).
# Copie para supabase/.env (ignorado pelo git) e preencha com o cliente OAuth do Google Cloud.
# Em produção estes valores ficam no painel do Supabase (Authentication → Providers → Google).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
