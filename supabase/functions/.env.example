# Segredos das Edge Functions. Nunca exponha estes valores no frontend.
# Em produção: npx supabase secrets set --env-file supabase/functions/.env
OPENAI_API_KEY=sk-...

# Opcionais
# Modelo de texto (Responses API, precisa aceitar saída estruturada e reasoning.effort)
# OPENAI_TEXT_MODEL=gpt-6.1-sol
# Modelo de imagem (Image API)
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Cota por usuário nas últimas 24 horas
# AI_DAILY_TEXT_LIMIT=40
# AI_DAILY_IMAGE_LIMIT=15
# Origens que podem chamar as funções, separadas por vírgula (vazio = qualquer origem)
# ALLOWED_ORIGINS=https://seu-dominio.com,http://localhost:5173
