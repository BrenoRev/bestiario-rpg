# Secrets for the Edge Functions — never expose these in the frontend.
# In production: supabase secrets set --env-file supabase/functions/.env
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the Claude model (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=sk-...
# Optional: override the image model (default: gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1
